# Supabase Configuration
# Get these values from your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# API Configuration
NEXT_PUBLIC_METRICS_API=https://app.everspeak.ai
NEXT_PUBLIC_API_HOST=https://app.everspeak.ai
# Server-only key when main app protects /metrics and /health/* (optional locally)
METRICS_API_KEY=

# Optional Slack mention for platform alerts (e.g. <!channel> or <@U123>)
SLACK_ALERT_MENTION=

# Stripe Dashboard links (test vs live)
NEXT_PUBLIC_STRIPE_DASHBOARD_BASE=https://dashboard.stripe.com/test

# Azure Speech Services (if needed)
NEXT_PUBLIC_AZURE_SPEECH_KEY=your-azure-speech-key
NEXT_PUBLIC_AZURE_REGION=westeurope

# ROI Dashboard pricing model (V1)
# JSON object keyed by plan tier
ROI_PLAN_MONTHLY_PRICES_JSON={"free":0,"starter":49,"pro":199,"business":499,"enterprise":999}
# Optional non-zero value if free tier should contribute modeled revenue
ROI_FREE_TIER_MONTHLY_VALUE=0
# Usage-priced revenue model aligned to everspeak.ai/pricing
ROI_USAGE_REVENUE_PRICING_JSON={"payg_eur_per_hour_lang":30,"bundle_eur_per_hour_lang":28.26}
# Free allowance threshold before automatic PAYG overage pricing kicks in
ROI_FREE_ALLOWANCE_JSON={"max_minutes":10,"max_target_languages":1}
# DeepL specific pricing (base subscription + usage)
ROI_DEEPL_PRICING_JSON={"base_eur_per_month":4.99,"usage_eur_per_million_chars":20,"billing_period_days":31,"base_allocation_mode":"all_rows"}
# Optional: pull actual daily OpenAI org costs and blend into ROI costs
ROI_OPENAI_COSTS_ENABLED=false
ROI_OPENAI_USD_TO_EUR=0.92
ROI_OPENAI_LINE_ITEM_ALLOWLIST=audio,completions,speech
ROI_OPENAI_PROJECT_IDS=
# OPENAI_ADMIN_API_KEY=sk-...
# Exclude internal/test admin accounts from ROI
ROI_EXCLUDED_ADMIN_EMAILS=ralfsfadejevs@gmail.com,alans@linearis.io
# Optional explicit user IDs to exclude (if email lookup is unavailable)
ROI_EXCLUDED_ADMIN_USER_IDS_JSON=[]
# Fallback estimated cost model used when event cost fields are empty (USD/min)
ROI_ESTIMATED_COST_PER_MINUTE_JSON={"asr":0.02,"translation":0.01,"tts":0.005,"llm":0.003}
# Cache duration for aggregate endpoints
ROI_CACHE_TTL_SECONDS=600
